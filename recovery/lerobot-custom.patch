+    def sync_read_registers(
+        self, registers: list[str], *, num_retry: int = 0
+    ) -> dict[str, dict[str, Value]]:
+        """Read a contiguous register block once, then decode individual feedback fields."""
+        if not registers:
+            return {}
+        self._assert_protocol_is_compatible("sync_read")
+        motors = list(self.motors)
+        ids = [self.motors[name].id for name in motors]
+        addresses = {}
+        for register in registers:
+            locations = {get_address(self.model_ctrl_table, self.motors[name].model, register)
+                         for name in motors}
+            if len(locations) != 1:
+                raise ValueError(f"Incompatible register addresses for {register}")
+            addresses[register] = locations.pop()
+        start = min(address for address, _ in addresses.values())
+        end = max(address + size for address, size in addresses.values())
+        self._setup_sync_reader(ids, start, end - start)
+        for _ in range(num_retry + 1):
+            comm = self.sync_reader.txRxPacket()
+            if self._is_comm_success(comm) and all(
+                self.sync_reader.isAvailable(id_, start, end - start) for id_ in ids
+            ):
+                break
+        else:
+            raise ConnectionError("Failed to read complete motor feedback block: "
+                                  + self.packet_handler.getTxRxResult(comm))
+        result = {}
+        for register, (address, size) in addresses.items():
+            values = self._decode_sign(register, {
+                id_: self.sync_reader.getData(id_, address, size) for id_ in ids
+            })
+            if register in self.normalized_data:
+                values = self._normalize(values)
+            result[register] = {self._id_to_name(id_): value for id_, value in values.items()}
+        return result
+
